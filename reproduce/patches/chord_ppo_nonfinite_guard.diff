+# Non-finite guard (not in NVIDIA's release). After the physics step, a world whose joint state is non-finite gets its
+# solver accelerations cleared and its episode ended with zero reward, so the environment resets it like any other
+# terminated world. Worlds with finite states are not changed.
+@wp.kernel
+def nonfinite_detect(
+    joint_q: wp.array(dtype=wp.float32),
+    joint_qd: wp.array(dtype=wp.float32),
+    q_start: wp.array(dtype=wp.int32),
+    qd_start: wp.array(dtype=wp.int32),
+    coord_count: int,
+    dof_count: int,
+    flag: wp.array(dtype=wp.int32),
+    count: wp.array(dtype=wp.int32),
+    qacc_warmstart: wp.array2d(dtype=wp.float32),
+    qacc: wp.array2d(dtype=wp.float32),
+) -> None:
+    """Flag worlds whose joint state is non-finite and clear their solver accelerations."""
+    world = wp.tid()
+    bad = int(0)
+    for i in range(coord_count):
+        if not wp.isfinite(joint_q[q_start[world] + i]):
+            bad = 1
+    for i in range(dof_count):
+        if not wp.isfinite(joint_qd[qd_start[world] + i]):
+            bad = 1
+    flag[world] = bad
+    if bad == 0:
+        return
+    wp.atomic_add(count, 0, 1)
+    for j in range(qacc_warmstart.shape[1]):
+        qacc_warmstart[world, j] = 0.0
+        qacc[world, j] = 0.0
+
+
+@wp.kernel
+def nonfinite_terminate(
+    flag: wp.array(dtype=wp.int32),
+    terminated: wp.array(dtype=wp.int32),
+    score: wp.array(dtype=wp.float32),
+    terms: wp.array(dtype=wp.float32),
+    term_count: int,
+    packed: wp.array(dtype=wp.float32),
+    packed_width: int,
+    pelvis_done: wp.array(dtype=wp.int32),
+) -> None:
+    """End the episode of a flagged world with zero reward, so that it is reset."""
+    world = wp.tid()
+    if flag[world] == 0:
+        return
+    terminated[world] = 1
+    score[world] = 0.0
+    for t in range(term_count):
+        terms[world * term_count + t] = 0.0
+    if packed_width > 0:
+        packed[world * packed_width] = 1.0
+        for i in range(1, packed_width):
+            packed[world * packed_width + i] = 0.0
+    if pelvis_done.shape[0] > 0:
+        pelvis_done[world] = 1
+
+
 class BaseEnv:
     """World-parallel physics, control, reference, termination, and reset state."""
 
