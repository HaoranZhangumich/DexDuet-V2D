+    def _nonfinite_setup(self) -> None:
+        """Buffers of the non-finite guard."""
+        w = self.world_count
+        m = self.model
+        self._nonfinite_coord_count = m.joint_coord_count // w
+        self._nonfinite_dof_count = m.joint_dof_count // w
+        self._nonfinite_q_start = wp.array(
+            m.joint_coord_world_start.numpy()[:w].astype(np.int32), dtype=wp.int32, device=self.device
+        )
+        self._nonfinite_qd_start = wp.array(
+            m.joint_dof_world_start.numpy()[:w].astype(np.int32), dtype=wp.int32, device=self.device
+        )
+        self._nonfinite_flag = wp.zeros(w, dtype=wp.int32, device=self.device)
+        self._nonfinite_count = wp.zeros(1, dtype=wp.int32, device=self.device)
+        self._nonfinite_reported = 0
+        self._nonfinite_empty_f = wp.zeros(1, dtype=wp.float32, device=self.device)
+        self._nonfinite_empty_i = wp.zeros(0, dtype=wp.int32, device=self.device)
+        data = self.solver.mjw_data
+        if data.qacc_warmstart.shape[0] != w:
+            raise ValueError(f"mjw_data has {data.qacc_warmstart.shape[0]} worlds, expected {w}")
+        self._nonfinite_qacc_warmstart = data.qacc_warmstart
+        self._nonfinite_qacc = data.qacc
+        print(f"[nonfinite guard] on: {w} worlds", flush=True)
+
+    def _nonfinite_detect(self) -> None:
+        wp.launch(
+            nonfinite_detect,
+            dim=self.world_count,
+            inputs=[
+                self.state_0.joint_q,
+                self.state_0.joint_qd,
+                self._nonfinite_q_start,
+                self._nonfinite_qd_start,
+                self._nonfinite_coord_count,
+                self._nonfinite_dof_count,
+            ],
+            outputs=[
+                self._nonfinite_flag,
+                self._nonfinite_count,
+                self._nonfinite_qacc_warmstart,
+                self._nonfinite_qacc,
+            ],
+        )
+
+    def _nonfinite_terminate(self) -> None:
+        terms = getattr(self.objective, "terms", None)
+        score = getattr(self.objective, "score", None)
+        packed = getattr(self.termination, "packed_diagnostics", None)
+        pelvis_done = getattr(self.termination, "pelvis_done", None)
+        wp.launch(
+            nonfinite_terminate,
+            dim=self.world_count,
+            inputs=[self._nonfinite_flag],
+            outputs=[
+                self.terminated,
+                self._nonfinite_empty_f if score is None else score,
+                self._nonfinite_empty_f if terms is None else terms,
+                0 if terms is None else terms.shape[0] // self.world_count,
+                self._nonfinite_empty_f if packed is None else packed,
+                0 if packed is None else packed.shape[0] // self.world_count,
+                self._nonfinite_empty_i if pelvis_done is None else pelvis_done,
+            ],
+        )
+
+    def nonfinite_report(self, iteration: int) -> None:
+        """Print how many worlds the guard has reset when that number has grown."""
+        count = int(self._nonfinite_count.numpy()[0])
+        if count != self._nonfinite_reported:
+            print(f"[nonfinite guard] iteration {iteration}: {count - self._nonfinite_reported} world(s) reset, "
+                  f"{count} in total", flush=True)
+            self._nonfinite_reported = count
+
